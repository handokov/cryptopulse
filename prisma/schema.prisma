// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  holdings     Holding[]
  snapshots    PortfolioSnapshot[]
  alerts       PriceAlert[]
  exchanges    ExchangeConnection[]
}

model Holding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinId        String
  symbol        String
  name          String
  image         String?
  quantity      Float
  purchasePrice Float
  purchaseDate  DateTime
  // Non-null only for holdings auto-imported from an exchange connection.
  // Each sync upserts quantities for this connection and removes positions
  // that no longer exist on the exchange. Manual holdings are never touched.
  connectionId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([connectionId])
}

model ExchangeConnection {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "binance" | "bitget" | "tokocrypto" | "demo"
  exchange         String
  label            String?
  // AES-256-GCM ciphertext (src/lib/secure.ts) — plaintext never hits the DB.
  apiKeyEnc        String
  apiSecretEnc     String
  apiPassphraseEnc String?
  // Masked display form (first4…last4) — safe to render in the UI.
  apiKeyMasked     String
  // SHA-256 of the raw API key — lets us reject exact duplicates without
  // ever decrypting anything.
  apiKeyHash       String
  // "active" | "error"
  status           String    @default("active")
  lastError        String?
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, exchange, apiKeyHash])
  @@index([userId])
}

model PortfolioSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String // UTC "YYYY-MM-DD"
  totalValue Float
  totalCost  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinId      String
  symbol      String
  name        String
  image       String?
  targetPrice Float
  direction   String // "above" | "below"
  // Price snapshot taken when the alert is armed. null = never armed yet
  // (fires as soon as the condition holds); once armed, only a FRESH crossing
  // of the target re-fires it (prevents instant re-trigger loops after re-arm).
  baselinePrice Float?
  triggered   Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
